{
  "name": "mythgram",
  "version": "1.0.0",
  "type": "module",
  "description": "Mythgram - Autonomous General Purpose AI Agent",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "tsx src/tools/run-tests.ts",
    "daemon": "tsx src/deamon/index.ts",
    "daemon:start": "tsx src/deamon/index.ts start",
    "daemon:stop": "tsx src/deamon/index.ts stop",
    "daemon:restart": "tsx src/deamon/index.ts restart",
    "daemon:status": "tsx src/deamon/index.ts status",
    "daemon:logs": "tsx src/deamon/index.ts logs",
    "daemon:ensure": "tsx src/deamon/index.ts ensure",
    "daemon:doctor": "tsx src/deamon/index.ts doctor",
    "daemon:install": "tsx src/deamon/index.ts install",
    "daemon:uninstall": "tsx src/deamon/index.ts uninstall"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "@hono/node-server": "^1.13.8",
    "@hono/node-ws": "^1.2.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.14",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tar": "^7.4.3",
    "tesseract.js": "^6.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.4",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "typescript-language-server": "^4.4.1"
  },
  "bin": {
    "mythgram": "bin/mythgram.mjs",
    "mythgram-daemon": "bin/mythgram-daemon.mjs"
  }
}
